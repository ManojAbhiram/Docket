# Copy to .env for local development. Never commit .env.
# Every variable the code reads is listed here with a placeholder, never a real secret.
APP_NAME=Docket
ENV=development
PORT=8080
LOG_LEVEL=debug
LOG_FORMAT=console
# Production refuses the example password (postgres, password, changeme).
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/docket
DB_POOL_SIZE=5
DB_POOL_MAX_OVERFLOW=10
DB_ECHO=false
# /readyz answers 503 if a dependency takes longer than this many seconds.
READINESS_TIMEOUT_SECONDS=2
# The OCR engine behind the gateway: "rapidocr" runs locally in a child process (ADR-0001, ADR-0011).
# "recorded" replays answers saved in GATEWAY_RECORDING and never runs a model (tests).
GATEWAY_ENGINE=rapidocr
GATEWAY_RECORDING=
# Read uploaded documents inside this process (ADR-0011). Needs WEB_CONCURRENCY=1.
WORKER_ENABLED=true
WORKER_IDLE_SECONDS=2
SWEEP_INTERVAL_SECONDS=60
# A read past this many seconds is killed and the document fails with reason timeout.
READ_TIMEOUT_SECONDS=120
# The engine child is replaced after this many documents, to bound memory growth.
ENGINE_RECYCLE_AFTER=500
# Placeholder: the real cap and whether the count survives a restart are open (question Q-009).
GATEWAY_CALL_CAP=1000
# Fields below this confidence go to Needs review. Provisional, from ADR-0005.
REVIEW_CONFIDENCE_CUTOFF=0.9804
# Token-sorted name similarity needed to match, 0 to 1. Set from the eval (question Q-003).
NAME_MATCH_THRESHOLD=0.85
# The applications CSV: largest file in bytes and most data rows (US-00-001).
IMPORT_MAX_BYTES=5000000
IMPORT_MAX_ROWS=20000
# Largest document upload in bytes (ADR-0008). The cap is counted while the body streams in.
UPLOAD_MAX_BYTES=8388608
# Sessions (ADR-0006). The cookie is Secure by default; browsers still send it to localhost.
# Set false only if you run the frontend over plain http on another host name. Production refuses false.
SESSION_COOKIE_SECURE=true
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=8
# Comma separated origins a state-changing request may come from (the CSRF Origin check).
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
# Failed sign-ins before a lock, per account and per source, and the window and lock in minutes.
LOGIN_MAX_FAILURES=5
LOGIN_SOURCE_MAX_FAILURES=20
LOGIN_WINDOW_MINUTES=15
LOGIN_LOCK_MINUTES=15
# Password hashes computed at once; each takes ARGON2_MEMORY_KIB of memory.
LOGIN_HASH_CONCURRENCY=2
# Sign ups allowed from one source address per window. The source is the connecting address:
# behind a proxy trust forwarded headers only from the proxy itself (never *), have the proxy
# overwrite X-Forwarded-For, and keep WEB_CONCURRENCY=1 (limits are per worker). docs/security/AUTH.md.
REGISTER_MAX_PER_SOURCE=10
REGISTER_WINDOW_MINUTES=60
ARGON2_MEMORY_KIB=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=1
# Tracing is off until this is set (OTLP over HTTP, e.g. http://localhost:4318).
OTEL_EXPORTER_OTLP_ENDPOINT=
