# Copy to .env for local development. Never commit .env.
# Every variable the code reads is listed here with a placeholder, never a real secret.
APP_NAME=Docket
ENV=development
PORT=8080
LOG_LEVEL=debug
LOG_FORMAT=console
# Production refuses the example password (postgres, password, changeme).
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/docket
DB_POOL_SIZE=5
DB_POOL_MAX_OVERFLOW=10
DB_ECHO=false
# /readyz answers 503 if a dependency takes longer than this many seconds.
READINESS_TIMEOUT_SECONDS=2
# The OCR engine behind the gateway. "recorded" replays saved answers and never calls a model.
GATEWAY_ENGINE=recorded
# Placeholder: the real cap and whether the count survives a restart are open (question Q-009).
GATEWAY_CALL_CAP=1000
# Fields below this confidence go to Needs review. Provisional, from ADR-0005.
REVIEW_CONFIDENCE_CUTOFF=0.9804
# Token-sorted name similarity needed to match, 0 to 1. Set from the eval (question Q-003).
NAME_MATCH_THRESHOLD=0.85
# Tracing is off until this is set (OTLP over HTTP, e.g. http://localhost:4318).
OTEL_EXPORTER_OTLP_ENDPOINT=
