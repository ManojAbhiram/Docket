# Docket: single-page app on an unprivileged nginx (port 8080). This is an nginx template: the
# official image replaces ${API_UPSTREAM} at start-up (default http://api:8080, see the Dockerfile).
# TLS, HSTS and rate limits belong on the ingress in front of this container.
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/json application/javascript image/svg+xml font/woff2;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    # Widen connect-src when the API lives on another origin.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;

    # Container liveness, distinct from the API's own /healthz.
    location = /healthz {
        default_type application/json;
        return 200 '{"status":"ok"}';
    }

    # Hashed assets are immutable; index.html is not. `expires` is used instead
    # of add_header so the security headers above still reach these locations
    # (an add_header in a location replaces every inherited add_header).
    location /assets/ {
        expires 1y;
        try_files $uri =404;
    }

    location = /index.html {
        expires -1;
    }

    # Same-origin API (ADR-0004, ADR-0006): the browser only ever talks to this origin, so the
    # session cookie stays first party. proxy_pass has no URI part on purpose: the API serves its
    # routes under /api, so the path must reach it unchanged. API_UPSTREAM is filled in from the
    # environment when the container starts. X-Forwarded-For is set to the connecting address, not
    # appended, so a client cannot choose the source the sign-in limiter sees.
    location /api/ {
        # Compressing would turn the API's strong ETag into a weak one, which decisions send back.
        gzip off;
        client_max_body_size 9m;
        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_read_timeout 90s;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
