# Copy to deploy/production.env and fill in. Never commit the filled-in copy.
# Every value in this example is a placeholder.

# Database password. Production refuses the example passwords postgres, password and changeme.
POSTGRES_PASSWORD=change-me-to-a-long-random-value

# The public origin people type in the browser, with the scheme and no trailing slash.
# State-changing requests must come from this origin.
PUBLIC_ORIGIN=https://docket.example.com

# Which host port the web container publishes (put TLS in front of it).
WEB_PORT=8081

# A label for the image tag, for example a short commit id. Makes a rollback a one-line change.
DOCKET_VERSION=local

# API memory ceiling. About 450 MB peak was measured; 640m leaves room.
API_MEM_LIMIT=640m

# Opt-in Vision: leave both empty to keep it off. Page images go to OpenRouter when it is on.
# The model must end in :free. The key is a secret: set it only in the filled-in copy.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
